{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADB Consent Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_ref",
    "device_ref",
    "purpose",
    "allowed_capabilities",
    "visible_indicator",
    "expires_at",
    "local_confirmed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "session_ref": {
      "type": "string"
    },
    "device_ref": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 3
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "visible_indicator": {
      "const": true
    },
    "local_confirmed": {
      "const": true
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
